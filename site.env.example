# Site configuration for running flashembed's Slurm jobs. Copy to local/site.env (local/ is gitignored), adjust,
# and pass its path to every job as EMBED_ENV:  sbatch --export=ALL,EMBED_ENV=$PWD/local/site.env slurm/build.sbatch
# Keep cluster-specific values (accounts, partitions, paths) in local/, never in tracked files.

# Persistent, group-shared storage for the code copy, toolchains, venv, HF cache, ONNX graphs, inputs and outputs.
export EMBED_ROOT=/path/to/storage/flashembed
# export EMBED_CODE=$EMBED_ROOT/code        # where this repository is synced to (default)
# export EMBED_VENV=$EMBED_ROOT/venv        # Python baseline venv (slurm/venv.sbatch)

# Scheduler defaults: sbatch reads these from the environment (or pass the equivalent sbatch options).
# export SBATCH_ACCOUNT=<account>
# export SBATCH_QOS=<qos>
# export SBATCH_PARTITION=<partition>

# FFmpeg for audio/video: use the same major version as the Python side's PyAV/torchcodec (slurm/ffmpeg.sbatch
# builds one into $EMBED_ROOT/ffmpeg9); otherwise ffmpeg/ffprobe from PATH are used.
# export FLASHEMBED_FFMPEG=$EMBED_ROOT/ffmpeg9/bin/ffmpeg
# export FLASHEMBED_FFPROBE=$EMBED_ROOT/ffmpeg9/bin/ffprobe

# Account guard (slurm/guard.sh): a job whose account or QOS fails these regexes cancels itself at start, and
# `flashembed_sbatch` refuses to submit one. Forbidden is checked first; leave both unset for no restriction.
# export FLASHEMBED_ALLOWED_ACCOUNTS='^(<account1>|<account2>)(-<qos suffix>)?$'
# export FLASHEMBED_FORBIDDEN_ACCOUNTS='<account that must never be charged>'

source "$EMBED_ROOT/code/py/env.sh"
source "$EMBED_ROOT/code/slurm/guard.sh"
